{
  "name": "@statedock/db",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/migrations && cp src/migrations/*.sql dist/migrations/",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@statedock/core": "workspace:*",
    "drizzle-orm": "^0.39.3"
  },
  "license": "AGPL-3.0-only"
}
